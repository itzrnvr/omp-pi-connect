{
  "name": "pi-connect-omp",
  "version": "0.1.3-omp1",
  "description": "Unified OAuth and API key login for oh-my-pi (OMP) with an OpenCode-inspired UI. Connect 15+ providers with one /connect command. OMP-compatible fork of pi-connect.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "omp-package",
    "omp-extension",
    "oh-my-pi",
    "pi-connect",
    "oauth",
    "api-key",
    "provider-login",
    "auth"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itzrnvr/pi-connect.git"
  },
  "homepage": "https://github.com/itzrnvr/pi-connect#readme",
  "bugs": {
    "url": "https://github.com/itzrnvr/pi-connect/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "index.ts",
    "README.md",
    "LICENSE",
    "assets"
  ],
  "publishConfig": {
    "access": "public"
  },
  "omp": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/itzrnvr/pi-connect/main/assets/screenshot.png"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": "*",
    "@oh-my-pi/pi-ai": "*",
    "@oh-my-pi/pi-tui": "*"
  }
}
